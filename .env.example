# Copy to .env and fill in. Never commit .env.
#
# n8n (phase 1) keeps its own credentials in n8n's credential store, not here. This file still
# lists what each phase needs, so the accounts to create are in one place.

# Frontier models — the courses use OpenAI most, others where noted
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Routing / local alternatives (cheaper options the courses suggest)
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Phase 1 — AI Builder · module 1, Automate
MARKETSTACK_API_KEY=
TELEGRAM_BOT_TOKEN=
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Phase 1 — AI Builder · module 2, Accelerate (voice + RAG)
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=

# Phase 1 — AI Builder · module 3, Amplify (MCP + multi-agent GTM)
FIRECRAWL_API_KEY=
HUNTER_API_KEY=
TAVILY_API_KEY=
PIPEDRIVE_API_TOKEN=

# Search tools used by later phases
SERPER_API_KEY=
BRAVE_API_KEY=

# Optional cost guardrail for my own scripts
MONTHLY_API_BUDGET_USD=25
