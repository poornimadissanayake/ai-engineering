      "name": "Calculator"
    },
    {
      "parameters": {
        "toolDescription": "Converts an amount between currencies at today's ECB reference rate. Use it when someone asks for a price in a currency other than USD.",
        "url": "https://api.frankfurter.app/latest",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "amount",
              "value": "={{ $fromAI('amount', 'The amount to convert', 'number') }}"
            },
            {
              "name": "from",
              "value": "={{ $fromAI('from_currency', 'Three-letter ISO code to convert from, e.g. USD', 'string') }}"
            },
            {
              "name": "to",
              "value": "={{ $fromAI('to_currency', 'Three-letter ISO code to convert to, e.g. EUR', 'string') }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        520,
        460
      ],
      "id": "4cfdc969-eaf6-5e21-95b4-5f7bd5fa77d0",
      "name": "Convert Currency"
    }
