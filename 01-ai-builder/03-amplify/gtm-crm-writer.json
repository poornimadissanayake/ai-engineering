      "id": "d167d0d1-c404-5396-b075-bbfc7a51a195",
      "name": "When Called by Orchestrator"
    },
    {
      "parameters": {
        "jsCode": "// leads_json arrives from the orchestrator as a JSON string (or, depending on\n// how the model fills it, an array). Re-validate here: this workflow writes to\n// the CRM, so it does not trust what it is handed.\nconst MAX_FIELD = 200;\nconst emailRe = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst clean = (v) => String(v ?? '').replace(/[\\r\\n\\t]+/g, ' ').trim().slice(0, MAX_FIELD);\n\nlet input = $input.first().json.leads_json;\nif (typeof input === 'string') {\n  try {\n    input = JSON.parse(input);\n  } catch (e) {\n    throw new Error('leads_json is not valid JSON.');\n  }\n}\nconst list = Array.isArray(input) ? input : Array.isArray(input?.leads) ? input.leads : [];\n\nconst leads = list\n  .map((l) => ({\n    company: clean(l.company),\n    domain: clean(l.domain).toLowerCase(),\n    contact_name: clean(l.contact_name),\n    contact_email: clean(l.contact_email).toLowerCase(),\n    title: clean(l.title),\n    reason: clean(l.reason),\n  }))\n  .filter((l) => l.company && emailRe.test(l.contact_email));\n\nif (leads.length === 0) {\n  throw new Error('No valid leads in leads_json (each needs company and contact_email).');\n}\nreturn leads.map((json) => ({ json }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "id": "feace957-6266-5c21-9ff1-69c85cebbc2e",
      "name": "Split Leads"
    },
    {
