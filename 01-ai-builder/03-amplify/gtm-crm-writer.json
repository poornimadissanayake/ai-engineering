    },
    {
      "parameters": {
        "jsCode": "// Runs once, when the loop is done. This is what the orchestrator gets back.\nconst results = $input.all().map((i) => i.json);\nreturn [{\n  json: {\n    created: results.filter((r) => r.status.startsWith('created')).length,\n    existing: results.filter((r) => r.status === 'existing_contact').length,\n    results,\n  },\n}];\n"
      },
