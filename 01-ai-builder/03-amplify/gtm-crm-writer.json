        "jsCode": "const lead = $('Lead With Org').item.json;\nreturn {\n  json: {\n    company: lead.company,\n    contact_name: lead.contact_name,\n    contact_email: lead.contact_email,\n    title: lead.title,\n    org_id: lead.org_id,\n    person_id: $('Create Person').item.json.id,\n    deal_id: $json.id,\n    status: lead.org_created ? 'created_org_person_deal' : 'created_person_deal',\n  },\n};\n"
      },
      "type": "n8n-nodes-base.code",
