# Copy to .env and fill in. Never commit .env.

# Only the chat assistant needs these. The board works without a key.
OPENROUTER_API_KEY=
# Any OpenRouter model that supports tool calling. Blank means openai/gpt-4o-mini.
OPENROUTER_MODEL=

# Optional
# KANBAN_DB=data/kanban.db
# KANBAN_COLUMNS=To Do,In Progress,Done
# KANBAN_SEED=1
